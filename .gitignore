# ==============================================================================
# UzOS Enterprise Git Ignore Rules
# ==============================================================================

# Build artifacts & temporary directories
build/
build_*/
bin/
out/
target/

# Object files & archives
*.o
*.obj
*.a
*.lib
*.so
*.dylib
*.dll
*.exe

# CMake temporary files
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
Makefile
*.ninja
.ninja_*
*.cmake
!CMakeLists.txt

# IDE & Editor files
.vscode/
.idea/
*.suo
*.user
*.user.*
*.sln
*.vcxproj
*.vcxproj.filters

# Temporary files & logs
*.log
*.tmp
*.bak
~*
thumbs.db
.DS_Store

# Tool caches
tools/python/Scripts/
__pycache__/
*.pyc
