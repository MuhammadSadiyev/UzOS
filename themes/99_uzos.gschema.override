[org.gnome.desktop.interface]
gtk-theme='UzOS-Telegram-Dark'
icon-theme='UzOS-Telegram'
color-scheme='prefer-dark'
accent-color='blue'
font-name='Inter 11'
document-font-name='Inter 11'
monospace-font-name='Monospace 11'

[org.gnome.desktop.background]
picture-uri='file:///usr/share/backgrounds/uzos-telegram-dark.svg'
picture-uri-dark='file:///usr/share/backgrounds/uzos-telegram-dark.svg'
picture-options='zoom'
primary-color='#0e1621'

[org.gnome.desktop.screensaver]
picture-uri='file:///usr/share/backgrounds/uzos-telegram-dark.svg'
picture-options='zoom'

[org.gnome.desktop.wm.preferences]
theme='UzOS-Telegram-Dark'
button-layout='appmenu:minimize,maximize,close'

[org.gnome.shell]
favorite-apps=['install-uzos.desktop', 'org.gnome.Nautilus.desktop', 'org.gnome.Terminal.desktop']
