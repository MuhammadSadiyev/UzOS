#!/usr/bin/env bash
# ==============================================================================
# UzOSFetch — O'zbekiston Milliy Operatsion Tizimi Axborot Vositası
# ==============================================================================

# Ranglar
C_RESET="\033[0m"
C_BOLD="\033[1m"
C_CYAN="\033[38;5;39m"
C_BLUE="\033[38;5;33m"
C_GREEN="\033[38;5;48m"
C_WHITE="\033[38;5;255m"
C_GRAY="\033[38;5;245m"

# Tizim ma'lumotlarini yig'ish
UPTIME=$(uptime -p 2>/dev/null | sed 's/up //' || echo "hozir yuklandi")
KERNEL=$(uname -r)
SHELL_NAME=$(basename "$SHELL")

# RAM ma'lumotlari
MEM_TOTAL=$(grep MemTotal /proc/meminfo 2>/dev/null | awk '{print int($2/1024)}' || echo "8192")
MEM_AVAIL=$(grep MemAvailable /proc/meminfo 2>/dev/null | awk '{print int($2/1024)}' || echo "7812")
MEM_USED=$((MEM_TOTAL - MEM_AVAIL))

cat <<EOF
${C_CYAN}         /\         ${C_RESET}  ${C_BOLD}${C_WHITE}Foydalanuvchi:${C_RESET} ${USER}@uzos
${C_CYAN}        /  \        ${C_RESET}  ${C_BOLD}${C_WHITE}OS:${C_RESET} UzOS 24.04 LTS (Noble Numbat)
${C_CYAN}       / /\ \       ${C_RESET}  ${C_BOLD}${C_WHITE}Negiz:${C_RESET} Ubuntu 24.04 Minimal Base
${C_CYAN}      / /  \ \      ${C_RESET}  ${C_BOLD}${C_WHITE}Yadro:${C_RESET} Linux ${KERNEL} (Low-Latency)
${C_CYAN}     / / /\ \ \     ${C_RESET}  ${C_BOLD}${C_WHITE}Interfeys:${C_RESET} Telegram UI Desktop (Native Qt6)
${C_CYAN}    / / /  \ \ \    ${C_RESET}  ${C_BOLD}${C_WHITE}Mavzu:${C_RESET} UzOS-Telegram-Dark [GTK3/4]
${C_CYAN}   /_/ /    \ \_\   ${C_RESET}  ${C_BOLD}${C_WHITE}Ikonkalar:${C_RESET} UzOS-Telegram
${C_CYAN}     \ \    / /     ${C_RESET}  ${C_BOLD}${C_WHITE}Terminal:${C_RESET} ${SHELL_NAME}
${C_CYAN}      \ \__/ /      ${C_RESET}  ${C_BOLD}${C_WHITE}Xotira (RAM):${C_RESET} ${C_GREEN}${MEM_USED} MB${C_RESET} / ${MEM_TOTAL} MB ${C_GRAY}(Windows: ~3800 MB)${C_RESET}
${C_CYAN}       \____/       ${C_RESET}  ${C_BOLD}${C_WHITE}zRAM (zstd):${C_RESET} ${C_GREEN}100% Faol${C_RESET} (4GB RAM -> 8GB)
                     ${C_BOLD}${C_WHITE}Telemetriya:${C_RESET} ${C_GREEN}0 B (100% Bloklangan / Zero-Spy)${C_RESET}
                     ${C_BOLD}${C_WHITE}Paketlar:${C_RESET} APT + Flatpak (0 Snapd demoni)
EOF
